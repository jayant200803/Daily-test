# Copy to .env and paste your Atlas key (use a TEST key for these tests).
# The key is a secret: keep it here, do not commit .env.
ATLAS_API_KEY=atlas_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Day-2 speech-to-speech pipeline only: an OpenAI-compatible LLM key (default Groq, free).
# Not needed for the Day-1 tests. Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
